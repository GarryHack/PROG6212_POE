@model Event
@{
    var editing = Event.Id != null;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}
<div class="page-head"><h1>@ViewData["Title"]</h1></div>

<form method="post" enctype="multipart/form-data" asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.Id" novalidate>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label">Event name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label">Date</label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Durban" />
                        <span asp-validation-for="Location" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label">Distance (km)</label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Distance" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="panel">
                <label class="form-label">Event banner</label>
                @if (!string.IsNullOrEmpty(Model.BannerUrl))
                {
                    <img id="banner-preview" class="banner-preview" src="@Model.BannerUrl" alt="Current banner" />
                }
                else
                {
                    <img id="banner-preview" class="banner-preview d-none" alt="Banner preview" />
                }
                <input type="file" name="banner" class="form-control mt-2" accept="image/jpeg,image/png,image/webp,image/gif" data-preview="#banner-preview" />
                <div class="form-text">JPEG, PNG, WebP or GIF, up to 5 MB. Shown on the event page.</div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">@(editing ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-dark btn-lg" asp-action="Events">Cancel</a>
    </div>
</form>
