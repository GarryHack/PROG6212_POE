@model Results
@{
    ViewData["Title"] = "Results";
}
<a class="back-link" asp-action="Events">&larr; My events</a>
<div class="page-head"><h1>Results <small>@Model.Events.Name</small></h1></div>

@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.Concluded)
{
    <div class="alert alert-warning">This event is on @Fmt.Date(Model.Events.Date). You can capture results once it has taken place.</div>
}

@if (!Model.Rows.Any())
{
    <div class="empty"><h2>Nobody to score</h2><p>There are no active enrolments for this event.</p></div>
}
else
{
    <p class="text-muted">Saving a result publishes it straight away. It appears on the event page and in the participant's My Results.</p>
    <div class="table-responsive panel p-0">
        <table class="table rd-table mb-0 align-middle">
            <thead><tr><th>Participant</th><th>Category</th><th>Finish time (hh:mm:ss)</th><th>Position</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    if (row.Result != null)
                    {
                        <tr>
                            <td>@row.Enrolment.ParticipantName</td>
                            <td>@row.Enrolment.CategoryName</td>
                            <td class="num">@Fmt.Time(row.Result.FinishTime)</td>
                            <td><b>@Fmt.Ordinal(row.Result.Position)</b></td>
                            <td class="text-end"><span class="status status-confirmed">Published</span></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@row.Enrolment.ParticipantName</td>
                            <td>@row.Enrolment.CategoryName</td>
                            <td colspan="3">
                                <form asp-action="SaveResult" method="post" class="result-form">
                                    <input type="hidden" name="eventId" value="@Model.Events.Id" />
                                    <input type="hidden" name="enrolmentId" value="@row.Enrolment.Id" />
                                    <input name="finishTime" class="form-control form-control-sm" placeholder="01:45:30" pattern="\d{1,2}:[0-5]\d:[0-5]\d" inputmode="numeric" disabled="@(!Model.Concluded)" required />
                                    <input name="position" type="number" min="1" class="form-control form-control-sm" placeholder="1" disabled="@(!Model.Concluded)" required />
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(!Model.Concluded)">Publish</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
}